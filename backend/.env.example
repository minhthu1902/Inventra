NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/inventra
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000

# Optional SMTP. Leave blank to test locally with a verification URL in the signup response.
# Gmail: smtp.gmail.com, port 587, secure=false; use a Google App Password, not account password.
# Yahoo: smtp.mail.yahoo.com, port 465, secure=true; use a Yahoo app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
