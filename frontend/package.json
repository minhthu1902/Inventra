{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm --prefix ../backend run dev\" \"npm run dev\"",
