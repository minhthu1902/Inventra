    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0"
  }
